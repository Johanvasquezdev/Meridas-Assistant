# Backend API URL (On Vercel production, set to your deployed backend URL, e.g. https://api.yourdomain.com)
NEXT_PUBLIC_API_URL=https://your-backend-api.com
NEXT_PUBLIC_APP_NAME=Meridas
NEXT_PUBLIC_APP_VERSION=1.0.0

# Clerk Authentication (Required for login, signup, user sessions)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard/chat
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard/chat

# Stripe Billing (Optional / for subscription checkout)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
