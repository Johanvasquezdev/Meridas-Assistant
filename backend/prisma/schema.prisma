generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String         @id @default(uuid())
  name          String
  createdAt     DateTime       @default(now())
  apiKeyHash    String         @unique @map("api_key_hash")
  apiRequests   ApiRequest[]
  conversations Conversation[]
  documents         Document[]
  sources           Source[]
  questions         Question[]
  conflicts         Conflict[]
  authorityPolicies AuthorityPolicy[]
  auditEvents       AuditEvent[]
  subscription      Subscription?
  usage             Usage[]
  users             User[]
  widgetConfig      WidgetConfig?
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  tenantId  String
  createdAt DateTime @default(now())
  clerkId   String?  @unique
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  questions       Question[]
  reviewDecisions ReviewDecision[]

  @@index([tenantId])
}

model Subscription {
  id                   String    @id @default(uuid())
  tenantId             String    @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  plan                 String    @default("trialing")
  status               String    @default("trialing")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
}

model Document {
  id              String            @id @default(uuid())
  tenantId        String
  title           String?
  content         String
  status          DocumentStatus    @default(PENDING)
  errorMsg        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  audioSummaryUrl String?
  textSummary     String?
  textSummaryAt   DateTime?
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  chunks          DocumentChunk[]
  insights        DocumentInsight[]
  tables          DocumentTable[]

  @@index([tenantId])
}

model DocumentChunk {
  id           String                   @id @default(uuid())
  tenantId     String
  documentId   String
  chunkIndex   Int
  text         String
  vectorId     String                   @unique
  createdAt    DateTime                 @default(now())
  searchVector Unsupported("tsvector")? @map("search_vector")
  document     Document                 @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([tenantId])
  @@index([documentId])
}

model DocumentTable {
  id          String   @id @default(uuid())
  tenantId    String
  documentId  String
  title       String?
  headers     String[]
  rows        Json
  extractedAt DateTime @default(now())
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([documentId])
}

model DocumentInsight {
  id          String      @id @default(uuid())
  tenantId    String
  documentId  String
  type        InsightType
  label       String
  value       String
  unit        String?
  context     String?
  extractedAt DateTime    @default(now())
  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([documentId])
}

model Conversation {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  createdAt DateTime  @default(now())
  title     String?
  updatedAt DateTime  @default(now()) @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  messages  Message[]

  @@index([tenantId])
  @@index([tenantId, updatedAt])
}

model Message {
  id             String       @id @default(uuid())
  tenantId       String
  conversationId String
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([tenantId])
  @@index([conversationId])
}

model Usage {
  id             String   @id @default(uuid())
  tenantId       String
  inputTokens    Int
  outputTokens   Int
  createdAt      DateTime @default(now())
  responseTimeMs Int?
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
}

model WidgetSession {
  id           String   @id @default(uuid())
  tenantId     String
  sessionId    String
  messageCount Int      @default(0)
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  userAgent    String?
  ipHash       String?

  @@unique([tenantId, sessionId])
  @@index([tenantId])
}

model WidgetMessage {
  id        String   @id @default(uuid())
  tenantId  String
  sessionId String
  role      String
  content   String
  sources   Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([sessionId])
}

model WidgetConfig {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  primaryColor   String   @default("#7c3aed")
  position       String   @default("bottom-right")
  placeholder    String   @default("Ask us anything...")
  title          String   @default("Support")
  welcomeMessage String   @default("Hi! How can I help you today?")
  isEnabled      Boolean  @default(true)
  allowedOrigins String[] @default([])
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
}

model ApiRequest {
  id           String   @id @default(uuid())
  tenantId     String
  endpoint     String
  method       String
  statusCode   Int
  latencyMs    Int
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
}

enum InsightType {
  METRIC
  FACT
  DATE
  PERSON
  PROCESS
  REQUIREMENT
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model Source {
  id            String          @id @default(uuid())
  tenantId      String
  title         String
  domain        String          @default("OPERATIONAL_SOP")
  scopeSite     String?
  scopeSystem   String?
  ownerEmail    String?
  authorityRank Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  versions      SourceVersion[]

  @@index([tenantId])
  @@index([tenantId, scopeSite, scopeSystem])
}

model SourceVersion {
  id             String         @id @default(uuid())
  sourceId       String
  versionNumber  String
  status         SourceStatus   @default(ACTIVE)
  fileHash       String
  effectiveDate  DateTime       @default(now())
  expirationDate DateTime?
  author         String?
  supersededById String?
  createdAt      DateTime       @default(now())
  source         Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  passages       Passage[]
  claims         Claim[]

  @@unique([sourceId, versionNumber])
  @@index([sourceId])
  @@index([fileHash])
}

model Passage {
  id              String                   @id @default(uuid())
  sourceVersionId String
  passageIndex    Int
  startOffset     Int                      @default(0)
  endOffset       Int                      @default(0)
  text            String
  sectionTitle    String?
  vectorId        String?                  @unique
  searchVector    Unsupported("tsvector")? @map("search_vector")
  createdAt       DateTime                 @default(now())
  sourceVersion   SourceVersion            @relation(fields: [sourceVersionId], references: [id], onDelete: Cascade)
  claims          Claim[]
  evidenceLinks   EvidenceLink[]

  @@index([sourceVersionId])
}

model Claim {
  id              String           @id @default(uuid())
  tenantId        String
  sourceVersionId String?
  passageId       String?
  statement       String
  scopeKey        String?
  temporalScope   String?
  createdAt       DateTime         @default(now())
  sourceVersion   SourceVersion?   @relation(fields: [sourceVersionId], references: [id], onDelete: Cascade)
  passage         Passage?         @relation(fields: [passageId], references: [id], onDelete: SetNull)
  evidenceLinks   EvidenceLink[]
  conflictsAsA    Conflict[]       @relation("ClaimA")
  conflictsAsB    Conflict[]       @relation("ClaimB")

  @@index([tenantId])
  @@index([sourceVersionId])
  @@index([passageId])
}

model EvidenceLink {
  id              String                 @id @default(uuid())
  assessmentId    String
  claimId         String
  passageId       String
  relationship    EntailmentRelationship @default(SUPPORTS)
  entailmentScore Float                  @default(1.0)
  rationale       String?
  createdAt       DateTime               @default(now())
  assessment      Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  claim           Claim                  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  passage         Passage                @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([claimId])
  @@index([passageId])
}

model Question {
  id                String       @id @default(uuid())
  tenantId          String
  userId            String
  rawQuery          String
  normalizedQuery   String?
  targetScopeSite   String?
  targetScopeSystem String?
  riskLevel         RiskLevel    @default(LOW)
  createdAt         DateTime     @default(now())
  tenant            Tenant       @relation(fields: [tenantId], references: [id])
  user              User         @relation(fields: [userId], references: [id])
  assessments       Assessment[]

  @@index([tenantId])
  @@index([userId])
}

model Assessment {
  id                       String         @id @default(uuid())
  questionId               String
  decisionState            DecisionState  @default(SUPPORTED)
  plainAnswer              String?
  missingEvidenceGap       String?
  unresolvedConflictsCount Int            @default(0)
  evaluatedAt              DateTime       @default(now())
  question                 Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  evidenceLinks            EvidenceLink[]

  @@index([questionId])
}

model Conflict {
  id           String         @id @default(uuid())
  tenantId     String
  claimAId     String
  claimBId     String
  conflictType ConflictType   @default(DIRECT_CONTRADICTION)
  severity     String         @default("HIGH")
  status       ConflictStatus @default(DETECTED)
  assignedTo   String?
  detectedAt   DateTime       @default(now())
  resolvedAt   DateTime?
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  claimA       Claim          @relation("ClaimA", fields: [claimAId], references: [id], onDelete: Cascade)
  claimB       Claim          @relation("ClaimB", fields: [claimBId], references: [id], onDelete: Cascade)
  decisions    ReviewDecision[]

  @@index([tenantId])
  @@index([claimAId])
  @@index([claimBId])
}

model ReviewDecision {
  id              String         @id @default(uuid())
  conflictId      String
  decidedByUserId String
  decision        String
  scopeOverride   String?
  rationale       String
  decidedAt       DateTime       @default(now())
  conflict        Conflict       @relation(fields: [conflictId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [decidedByUserId], references: [id])

  @@index([conflictId])
  @@index([decidedByUserId])
}

model AuthorityPolicy {
  id              String         @id @default(uuid())
  tenantId        String
  domain          String
  scopePattern    String
  precedenceRules Json
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenant          Tenant         @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model AuditEvent {
  id           String         @id @default(uuid())
  tenantId     String
  actorId      String
  actionType   String
  entityType   String
  entityId     String
  payloadHash  String
  previousHash String?
  metadata     Json?
  timestamp    DateTime       @default(now())
  tenant       Tenant         @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([timestamp])
}

enum SourceStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum EntailmentRelationship {
  SUPPORTS
  CONTRADICTS
  NEUTRAL
}

enum DecisionState {
  SUPPORTED
  CONDITIONAL
  CANNOT_ESTABLISH
}

enum ConflictStatus {
  DETECTED
  IN_REVIEW
  RESOLVED
  FALSE_POSITIVE
}

enum ConflictType {
  DIRECT_CONTRADICTION
  SCOPE_MISMATCH
  TEMPORAL_SUPERSEDED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH_RISK
}
